# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# Logs
*.log
*.log.prev
*.pid
nohup.out

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Certificates (sensitive)
certs/*.pem
certs/*.key
certs/*.crt
!certs/*.md

# User database
MRRC_users.db

# Video build (large binaries)
video_build/

# Audio files (cq.wav is explicitly tracked)
*.wav
!cq.wav
venv/
logs/
recordings/
.iflow_logs/
website/logs/

# Virtual environments
venv_voxcpm/

# Backup files
*.bak
*.bakkk
MRRC.bak.conf

# Certificate backups
certs/backup/

# Local databases
website/stats/

# Claude Code session data
.claude/

# Presentations (large binaries)
*.pptx

# FT8 ULTRON (independent automation project; only base.json needed by ft8_integration.py)
ft8/*
!ft8/base.json

# Certificates: never track private keys (incl. subdirectory backups/legacy)
certs/backup/
certs/legacy/
*.orig
certs/*.zip

# Windows installer build artifacts
dist/
build/

# Bundled native libraries (place them locally, do not commit)
vendor/**/*.dll
vendor/**/*.dylib
vendor/**/*.so


# NR2 探针输出的试听 WAV（生成物）
dev_tools/nr2_out/

# 源码模式下的热修覆盖层（运行时目录，不入库）
patch/
dist/hotfix/

# 「🐞 遇到问题」在本机生成的诊断包（运行时产物，不入库；只匹配仓库根）
/support/

# 一键升级的运行时状态（state.json / upgrade.request）：真机在 %LOCALAPPDATA%\MRRC\updates，
# 只在测试脚本跑错目录时才会落到仓库根 —— 不入库
updates/

# 监控脚本采样输出（mrrc_monitor.sh mem/cpu 生成物）
perf_data_*.json

# macOS 构建产物（DSP 动态库，本机构建生成）
*.dylib
librnnoise*.dylib
libwdsp*.dylib
*.bak_*
*.bak-*
rigctld.managed.json

# ---- Cloud Hub（内网穿透）的运行时状态：本机身份与隧道，不入库 ----
# mrrc_cloud.json 里有申请令牌（bearer）与本机证书路径 —— 提交即泄漏，且每台机器各不相同。
# fleet/ 是本机 frpc 的配置与日志（frpc-<标签>.toml / *.log），不是构建载荷。
mrrc_cloud.json
/fleet/
rig_state.json

# 安装包内置的 frpc：构建输入，不入库（入库的是 packaging/payload.lock 的版本与哈希）。
# 取件：mrrc_hub/deploy/fetch_installer_payload.sh —— 见 dev_tools/fetch_payload.sh
packaging/payload/
