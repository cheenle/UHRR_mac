# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# Logs
*.log
*.pid
nohup.out

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Certificates (sensitive)
certs/*.pem
certs/*.key
certs/*.crt
!certs/*.md

# User database
MRRC_users.db

# Video build (large binaries)
video_build/

# Audio files (cq.wav is explicitly tracked)
*.wav
!cq.wav
venv/
logs/
recordings/
.iflow_logs/
website/logs/

# Virtual environments
venv_voxcpm/

# Backup files
*.bak
*.bakkk
MRRC.bak.conf

# Certificate backups
certs/backup/

# Local databases
website/stats/

# Claude Code session data
.claude/

# Presentations (large binaries)
*.pptx

# FT8 ULTRON (independent automation project; only base.json needed by ft8_integration.py)
ft8/*
!ft8/base.json

# Certificates: never track private keys (incl. subdirectory backups/legacy)
certs/backup/
certs/legacy/
*.orig
certs/*.zip

# Windows installer build artifacts
dist/
build/

# Bundled native libraries (place them locally, do not commit)
vendor/**/*.dll
vendor/**/*.dylib
vendor/**/*.so

