# WDSP fork patch: NR2(EMNR) SSB 语音保护（MRRC 2026-09-13）
# 应用: cd DSP/wdsp && patch -p1 < ../../DSP/patches/2026-09-13-nr2-ssb-voice-protection.patch
# 注意: DSP/wdsp 在主仓库里是失效的 gitlink，C 改动只能靠本 patch 版本化。

--- a/emnr.h	2026-09-13 10:05:00
+++ b/emnr.h	2026-09-13 10:05:05
@@ -75,6 +75,8 @@
 		double* prev_mask;
 		double* prev_gamma;
 		double gf1p5;
+		double max_atten;		// MRRC: 每 bin 最大衰减（线性掩码下限）；0 = 不限制（旧行为）
+		double dry;			// MRRC: 干湿混合 mask' = dry + (1-dry)*mask；0 = 纯湿
 		double alpha;
 		double eps_floor;
 		double gamma_max;
--- a/emnr.c	2026-09-13 10:05:00
+++ b/emnr.c	2026-09-13 10:05:05
@@ -487,6 +487,8 @@
 	a->g.gain_method = gain_method;
 	a->g.npe_method = npe_method;
 	a->g.ae_run = ae_run;
+	a->g.max_atten = 0.0;	// 0 = 不限制（保持旧行为，向后兼容）
+	a->g.dry = 0.0;
 	calc_emnr (a);
 	return a;
 }
@@ -807,6 +809,21 @@
 		}
 	}
 	if (a->g.ae_run) aepf(a);
+	// MRRC: SSB 语音保护 — 限制每 bin 衰减上限 / 可选干湿混合
+	// 依据: EMNR 最小统计在小信号/平稳段会把语音本身当噪声(lambda_d>lambda_y),
+	// 掩码塔陷到 0.02~0.25, 语音被整段削 10~33dB。
+	if (a->g.dry > 0.0 || a->g.max_atten > 0.0)
+	{
+		int m;
+		for (m = 0; m < a->g.msize; m++)
+		{
+			double mk = a->mask[m];
+			if (a->g.dry > 0.0) mk = a->g.dry + (1.0 - a->g.dry) * mk;
+			if (a->g.max_atten > 0.0 && mk < a->g.max_atten) mk = a->g.max_atten;
+			a->mask[m] = mk;
+			a->g.prev_mask[m] = mk;		// 决策导向环保持一致
+		}
+	}
 }
 
 void xemnr (EMNR a, int pos)
@@ -953,3 +970,20 @@
 	rxa[channel].emnr.p->ae.psi = psi;
 	LeaveCriticalSection (&ch[channel].csDSP);
 }
+
+PORT
+void SetRXAEMNRmaxAttenDb (int channel, double db)
+{
+	EnterCriticalSection (&ch[channel].csDSP);
+	// db < 0 → 掩码下限 = 10^(db/20)；db >= 0 → 不限制（关闭，回到旧行为）
+	rxa[channel].emnr.p->g.max_atten = (db < 0.0) ? pow (10.0, db / 20.0) : 0.0;
+	LeaveCriticalSection (&ch[channel].csDSP);
+}
+
+PORT
+void SetRXAEMNRdry (int channel, double dry)
+{
+	EnterCriticalSection (&ch[channel].csDSP);
+	rxa[channel].emnr.p->g.dry = (dry > 0.0) ? ((dry < 1.0) ? dry : 1.0) : 0.0;
+	LeaveCriticalSection (&ch[channel].csDSP);
+}
--- a/nbp.h	2026-09-13 10:05:00
+++ b/nbp.h	2026-09-13 10:06:02
@@ -93,6 +93,10 @@
 
 extern void setMp_nbp (NBP a);
 
+// MRRC: 设置 nbp0 的带通频点（SSB 带通由始终运行的 nbp0 承担），
+// 内部走 calc_nbp_impulse + setImpulse_fircore(...,1) 立即生效
+extern void SetRXANBPFreqs (int channel, double f_low, double f_high);
+
 __declspec (dllexport) void RXANBPSetFreqs (int channel, double flow, double fhigh);
 
 __declspec (dllexport) void RXANBPSetNC (int channel, int nc);
--- a/nbp.c	2026-09-13 10:05:00
+++ b/nbp.c	2026-09-13 10:06:02
@@ -615,5 +615,23 @@
 	{
 		b->autoincr = autoincr;
 		recalc_bpsnba_filter (b, 1);
+	}
+}
+
+PORT
+void SetRXANBPFreqs (int channel, double f_low, double f_high)
+{
+	// MRRC: nbp0 是 xrxa 中无条件运行的 FIR，用作 SSB 带通（不依赖 bp1）。
+	// 与 RXANBPSetAutoIncrease 同构：重算脉冲→立即激活→释放。
+	NBP a = rxa[channel].nbp0.p;
+	EnterCriticalSection (&ch[channel].csDSP);
+	if ((f_low != a->flow) || (f_high != a->fhigh))
+	{
+		a->flow  = f_low;
+		a->fhigh = f_high;
+		calc_nbp_impulse (a);						// fnfrun=0: fir_bandpass；fnfrun=1: fir_mbandpass
+		setImpulse_fircore (a->p, a->impulse, 1);	// 1 = 立即激活
+		_aligned_free (a->impulse);
 	}
+	LeaveCriticalSection (&ch[channel].csDSP);
 }
