# WDSP fork patch: Windows(MinGW-w64) 可构建性（MRRC 2026-09-13）
# 应用: cd DSP/wdsp && patch -p1 < ../../DSP/patches/2026-09-13-windows-mingw-build.patch
# 背景: 平台守卫写成 `defined(linux) || defined(__APPLE__)`，mingw 落到 MSVC 分支，
#       __declspec()/_int64/1i64 等 MSVC 专有写法在 GCC 下编译失败；iobuffs.h 的
#       `typedef struct _iob` 与 MSVCRT 的 stdio 内部符号 _iob 冲突；另外 mingw 的
#       windows.h 已声明同名 Win32 API，POSIX shim 需要前缀化才能链接。
# 影响: 只新增 __MINGW32__ 分支/改名，macOS 与 Linux 行为不变。
# 注意: DSP/wdsp 在主仓库里是失效的 gitlink，C 改动只能靠本 patch 版本化。

--- a/analyzer.c
+++ b/analyzer.c
@@ -607,5 +607,5 @@
 
 		EnterCriticalSection (&a->StitchSection);
-#if defined(linux) || defined(__APPLE__)
+#if defined(linux) || defined(__APPLE__) || defined(__MINGW32__)
                 a->stitch_flag |= 1L << ss;
 #else
@@ -613,5 +613,5 @@
 #endif
 
-#if defined(linux) || defined(__APPLE__)
+#if defined(linux) || defined(__APPLE__) || defined(__MINGW32__)
                 if (a->stitch_flag == ((1L << a->num_stitch) - 1))
 #else
@@ -693,5 +693,5 @@
 
 		EnterCriticalSection (&a->StitchSection);
-#if defined(linux) || defined(__APPLE__)
+#if defined(linux) || defined(__APPLE__) || defined(__MINGW32__)
                 a->stitch_flag |= 1L << ss;
 #else
@@ -699,5 +699,5 @@
 #endif
 
-#if defined(linux) || defined(__APPLE__)
+#if defined(linux) || defined(__APPLE__) || defined(__MINGW32__)
                 if (a->stitch_flag == ((1L << a->num_stitch) - 1))
 #else
