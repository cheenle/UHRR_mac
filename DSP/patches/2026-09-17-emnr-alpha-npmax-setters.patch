+PORT
+void SetRXAEMNRalpha (int channel, double alpha)
+{
+	EnterCriticalSection (&ch[channel].csDSP);
+	// 决策导向平滑（掩码时间平滑）：越大越平滑 → 音乐噪声/水声↓；过大则拖尾、跟不上语音起伏。
+	// 初始化等效值（48k/incr=256）≈0.9933；建议范围 0.990~0.998。
+	EMNR a = rxa[channel].emnr.p;
+	a->g.alpha = (alpha > 0.90) ? ((alpha < 0.9999) ? alpha : 0.9999) : 0.90;
+	LeaveCriticalSection (&ch[channel].csDSP);
+}
+
+PORT
+void SetRXAEMNRnpMax (int channel, double logref)
+{
+	EnterCriticalSection (&ch[channel].csDSP);
+	// 噪声估计“最大跟踪”平滑（初始化里 log(0.96) 那个）：越大噪声估计变化越慢 →
+	// 停顿间咕嘟/泵动↓；过大则语音结束后噪声底回填太慢。
+	EMNR a = rxa[channel].emnr.p;
+	if (logref > 0.50 && logref < 1.0)
+	{
+		double tau = -128.0 / 8000.0 / log (logref);
+		a->np.alphaMax = exp (-a->np.incr / a->np.rate / tau);
+	}
 	LeaveCriticalSection (&ch[channel].csDSP);
 }
