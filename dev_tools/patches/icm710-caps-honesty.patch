diff --git a/rigs/icmarine/icm710.c b/rigs/icmarine/icm710.c
--- a/rigs/icmarine/icm710.c
+++ b/rigs/icmarine/icm710.c
@@ -38,7 +38,10 @@
 
 #define ICM710_FUNC_ALL (RIG_FUNC_NB)
 
-#define ICM710_LEVEL_ALL (RIG_LEVEL_RFPOWER|RIG_LEVEL_AF|RIG_LEVEL_RF|RIG_LEVEL_AGC|RIG_LEVEL_RAWSTR)
+/* The M710 answers no queries -- it only echoes the command sentence (verified on
+ * hardware: $PICOA,90,01,SIGM*60 comes back with no value). RAWSTR therefore can
+ * never be read and must not be advertised: clients poll a dead level forever. */
+#define ICM710_LEVEL_ALL (RIG_LEVEL_RFPOWER|RIG_LEVEL_AF|RIG_LEVEL_RF|RIG_LEVEL_AGC)
 
 #define ICM710_VFO_ALL (RIG_VFO_A)
 
@@ -68,7 +71,7 @@
     .status =  RIG_STATUS_STABLE,
     .rig_type =   RIG_TYPE_TRANSCEIVER,
     .ptt_type =  RIG_PTT_RIG,
-    .dcd_type =  RIG_DCD_RIG,
+    .dcd_type =  RIG_DCD_NONE,   /* SQLS answers no value -- this rig has no queries */
     .port_type =  RIG_PORT_SERIAL,
     .serial_rate_min =  4800,
     .serial_rate_max =  4800,
@@ -80,7 +83,9 @@
     .post_write_delay =  0,
     .timeout =  500,
     .retry =  0,
-    .has_get_func =  ICM710_FUNC_ALL,
+    /* NB is write-only here: icm710_get_func() sends a query the M710 cannot
+     * answer, so it always reported "off". Keep the setter only. */
+    .has_get_func =  RIG_FUNC_NONE,
     .has_set_func =  ICM710_FUNC_ALL,
     .has_get_level =  ICM710_LEVEL_ALL,
     .has_set_level =  RIG_LEVEL_SET(ICM710_LEVEL_ALL),
